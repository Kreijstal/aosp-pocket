<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.kreijstal.aosppocket.guestbridge">
    <uses-sdk android:minSdkVersion="32" android:targetSdkVersion="32" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="Pocket Services" android:allowBackup="false">
        <provider android:name=".PackageEventsProvider" android:authorities="dev.kreijstal.aosppocket.guestbridge.events" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
