 void set_sysnum(Tracee *tracee, Sysnum sysnum)
 {
+#ifdef __ANDROID__
+	/* Android app seccomp traps syscall -1. Use a harmless permitted call
+	 * for fully emulated operations; their exit handlers use ORIGINAL. */
+	if (sysnum == PR_void)
+		sysnum = PR_getpid;
+#endif
 	poke_reg(tracee, SYSARG_NUM, detranslate_sysnum(get_abi(tracee), sysnum));
 }
 
