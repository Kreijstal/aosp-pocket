 int main(int argc, char *const argv[])
 {
+	/* Only the Pocket launcher opts in. A killed Android app must not leave
+	 * an orphan tracer; EXITKILL then contains the traced descendants. */
+	const char *pocket_parent = getenv("POCKET_PARENT_PID");
+	if (pocket_parent != NULL) {
+		char *end;
+		errno = 0;
+		long expected = strtol(pocket_parent, &end, 10);
+		if (errno || *end || expected <= 1 || expected > INT_MAX ||
+		    getppid() != (pid_t) expected || prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 ||
+		    getppid() != (pid_t) expected) {
+			fprintf(stderr, "Pocket tracer parent disappeared or death signal setup failed\n");
+			return EXIT_FAILURE;
+		}
+		unsetenv("POCKET_PARENT_PID");
+	}
 	Tracee *tracee;
 	int status;
 
