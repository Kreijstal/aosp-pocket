+
+// Pocket's owner-provisioned, guest-private boot configuration. No root-capable
+// injector or Android 10 Kotlin daemon is needed in the controlled Android 9 image.
+extern "C" bool teesim_control_load_file(const char* path) {
+  FILE* f = fopen(path, "rb");
+  if (!f) return false;
+  std::vector<char> bytes(kMaxFrame + 1);
+  const size_t n = fread(bytes.data(), 1, bytes.size(), f);
+  const bool bad = ferror(f) || n == 0 || n > kMaxFrame;
+  fclose(f);
+  if (bad) return false;
+  tjson::Value config;
+  if (!tjson::parse(bytes.data(), n, config)) return false;
+  // Unlike the modern daemon, this loader cannot harvest hardware boot info.
+  // Require an explicit software profile and boot description from the owner.
+  const auto* boot = config.get("bootInfo");
+  const auto* profiles = config.get("profiles");
+  if (!boot || !boot->get("deviceLocked") || !boot->get("verifiedBootState") ||
+      !profiles || !profiles->is_array()) return false;
+  uint64_t epoch = 0;
+  int applied = 0, total = 0;
+  ApplyConfig(config, epoch, applied, total);
+  LOGI("Pocket boot configuration applied profiles=%d/%d", applied, total);
+  return total > 0 && applied == total;
+}
