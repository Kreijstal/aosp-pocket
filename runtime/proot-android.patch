+/* Bionic validates root ownership when a newly exec'd app/compiler maps its
+ * property area. These guest files remain owned by guest root independently
+ * of the caller's emulated UID, while the real host ownership never changes. */
+static bool is_guest_property_fd(const Tracee *tracee, int fd)
+{
+	char proc_path[64], actual[PATH_MAX + 1], prefix[PATH_MAX + 1];
+	snprintf(proc_path, sizeof(proc_path), "/proc/%d/fd/%d", tracee->pid, fd);
+	ssize_t length = readlink(proc_path, actual, PATH_MAX);
+	if (length < 0) return false;
+	actual[length] = '\0';
+	int n = snprintf(prefix, sizeof(prefix), "%s/dev/__properties__/", get_root(tracee));
+	return n > 0 && n < (int) sizeof(prefix) && length >= n &&
+		memcmp(actual, prefix, n) == 0;
+}
 
