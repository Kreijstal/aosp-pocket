 }  // namespace
 
 status_t InstalldNativeService::start() {
+#ifndef POCKET_INSTALLD_COMPONENT
     IPCThreadState::self()->disableBackgroundScheduling(true);
+#else
+    // The core chooses its system-service Binder policy before starting threads.
+    // Complete installd's own globals before publishing the service.
+    sAppDataIsolationEnabled = android::base::GetBoolProperty(
+            kAppDataIsolationEnabledProperty, true);
+#endif
     status_t ret = BinderService<InstalldNativeService>::publish();
     if (ret != android::OK) {
         return ret;
     }
+#ifndef POCKET_INSTALLD_COMPONENT
     sp<ProcessState> ps(ProcessState::self());
     ps->startThreadPool();
     ps->giveThreadPoolName();
     sAppDataIsolationEnabled = android::base::GetBoolProperty(
             kAppDataIsolationEnabledProperty, true);
+#endif
     return android::OK;
 }
 
