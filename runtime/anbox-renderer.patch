+#ifdef __ANDROID__
+// Avoid vkQueueSignalReleaseImageANDROID/queuePresent on the software-only
+// nested test host. Read back the actual rendered pixels and post a CPU buffer.
+static bool pocket_present_cpu(RendererWindow* window) {
+  const int width = window->cpu_width, height = window->cpu_height;
+  window->pixels.resize(static_cast<size_t>(width) * height * 4);
+  glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, window->pixels.data());
+  if (glGetError() != GL_NO_ERROR) return false;
+  ANativeWindow_Buffer output;
+  if (ANativeWindow_lock(window->native_window, &output, nullptr) != 0) return false;
+  const int rows = std::min(height, output.height);
+  const int columns = std::min(width, output.width);
+  for (int y = 0; y < rows; ++y) {
+    auto* destination = static_cast<unsigned char*>(output.bits) + static_cast<size_t>(y) * output.stride * 4;
+    const auto* source = window->pixels.data() + static_cast<size_t>(height - 1 - y) * width * 4;
+    std::memcpy(destination, source, static_cast<size_t>(columns) * 4);
+  }
+  return ANativeWindow_unlockAndPost(window->native_window) == 0;
+}
+#endif
