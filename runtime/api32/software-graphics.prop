# Pocket Android 12L software display profile. Stock identity/SDK are retained.
ro.hardware.gralloc=pocket
ro.hardware.hwcomposer=pocket
ro.hardware.egl=swiftshader
ro.zygote=zygote64
ro.apex.updatable=false
sys.use_memfd=true
debug.renderengine.backend=gles
ro.sf.lcd_density=160
log.tag.HWC2On1Adapter=I
# Stock 12L scales its service, broadcast, process-start and input-dispatch
# ANR timeouts by this platform property, documented in android.os.Build for
# products running on software emulation orders of magnitude slower than real
# hardware. Pi VM boots measured SystemUI StartServices at p50 11s, p90 25s,
# max 51s (117 boots), against a stock 20s service-start limit that also covers
# process start and Application.onCreate. 4 gives 80s/40s/20s limits.
ro.hw_timeout_multiplier=4

# The 12L image is an emulator-style product whose framework leaves
# config_showNavigationBar off and relies on the emulator boot property to turn
# on the 3-button navigation bar (DisplayPolicy reads qemu.hw.mainkeys: 0 = show).
# Without it the guest has no back/home/recents bar.
qemu.hw.mainkeys=0

# Host cameras: cameraserver loads Pocket's in-process provider (legacy/0), 12L's
# external camera HAL streaming host frames (tools/build_api32_camera.py).
ro.pocket.camera.enabled=1
